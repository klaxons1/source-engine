@@ -26,6 +27,35 @@ namespace dxvk {
 
 extern "C" {
 
+  // Unique entry point: the legacy companion libtogl also exports Direct3DCreate9.
+  // Never let dynamic interposition give the native shaderapi a TOGL COM object.
+  DLLEXPORT IDirect3D9* DXVKSarekDirect3DCreate9(UINT) {
+    IDirect3D9Ex* result = nullptr;
+    dxvk::CreateD3D9(false, &result);
+    return result;
+  }
+
+  // The pointer MUST come from this library's matching factory above.
+  DLLEXPORT uint64_t DXVKSarekGetAdapterMemoryBytes(void* d3d9, uint32_t ordinal) {
+    if (!d3d9) return 0;
+    auto object = static_cast<dxvk::D3D9InterfaceEx*>(static_cast<IDirect3D9*>(d3d9));
+    auto adapter = object->GetAdapter(ordinal);
+    if (!adapter) return 0;
+    auto info = adapter->GetDXVKAdapter()->getMemoryHeapInfo();
+    uint64_t total = 0;
+    for (uint32_t i = 0; i < info.heapCount; i++) {
+      if (info.heaps[i].heapFlags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) {
+        uint64_t budget = info.heaps[i].memoryBudget;
+        if (budget > std::numeric_limits<uint64_t>::max() - total)
+          return std::numeric_limits<uint64_t>::max();
+        total += budget;
+      }
+    }
+    // Budget extension if present, advertised heap size otherwise. Not guessed RAM.
+    return total;
+  }
+
+
   DLLEXPORT IDirect3D9* __stdcall Direct3DCreate9(UINT nSDKVersion) {
     IDirect3D9Ex* pDirect3D = nullptr;
     dxvk::CreateD3D9(false, &pDirect3D);
