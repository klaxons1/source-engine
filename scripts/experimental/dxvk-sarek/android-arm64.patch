+      auto provider = windowProvider.load();
+      owned = provider != nullptr;
+      window = w ? (provider ? provider(w) : static_cast<ANativeWindow*>(w)) : nullptr;
+    }
+    ~NativeWindowRef() { if (owned && window) ANativeWindow_release(window); }
+  };
+
+  // Host must supply physical display data BEFORE Direct3DCreate9. No guessed
+  // resolutions/refresh rates. A provider may resolve stable host HWND tokens.
+  extern "C" __attribute__((visibility("default")))
+  bool DXVKSarekSetAndroidDisplay(uint32_t width, uint32_t height,
+      uint32_t refreshNumerator, uint32_t refreshDenominator) {
+    if (!width || !height || width > INT32_MAX || height > INT32_MAX
+        || !refreshNumerator || !refreshDenominator) return false;
+    std::lock_guard<std::mutex> lock(displayMutex);
+    displayMode = {width, height, {refreshNumerator, refreshDenominator}, 32, false};
+    return true;
+  }
+
+  class AndroidWsiDriver final : public WsiDriver {
+  public:
+    std::vector<const char*> getInstanceExtensions() override {
+      return {VK_KHR_ANDROID_SURFACE_EXTENSION_NAME};
+    }
+    HMONITOR getDefaultMonitor() override {
+      std::lock_guard<std::mutex> lock(displayMutex);
+      return displayMode.width ? monitor() : nullptr;
+    }
+    HMONITOR enumMonitors(uint32_t index) override {
+      return index == 0 ? getDefaultMonitor() : nullptr;
+    }
+    bool getDisplayName(HMONITOR m, WCHAR (&name)[32]) override {
+      if (m != monitor() || !getDefaultMonitor()) return false;
+      str::tows("Android", name);
+      return true;
+    }
+    bool getDesktopCoordinates(HMONITOR m, RECT* r) override {
+      WsiMode mode;
+      if (!r || !getCurrentDisplayMode(m, &mode)) return false;
+      *r = {0, 0, LONG(mode.width), LONG(mode.height)};
+      return true;
+    }
+    bool getDisplayMode(HMONITOR m, uint32_t index, WsiMode* mode) override {
+      return index == 0 && getCurrentDisplayMode(m, mode);
+    }
+    bool getCurrentDisplayMode(HMONITOR m, WsiMode* mode) override {
+      std::lock_guard<std::mutex> lock(displayMutex);
+      if (m != monitor() || !mode || !displayMode.width) return false;
+      *mode = displayMode;
+      return true;
+    }
+    void getWindowSize(HWND w, uint32_t* width, uint32_t* height) override {
+      NativeWindowRef ref(w);
+      int32_t x = ref.window ? ANativeWindow_getWidth(ref.window) : 0;
+      int32_t y = ref.window ? ANativeWindow_getHeight(ref.window) : 0;
+      if (width) *width = x > 0 ? uint32_t(x) : 0;
+      if (height) *height = y > 0 ? uint32_t(y) : 0;
+    }
+    void resizeWindow(HWND, DxvkWindowState*, uint32_t, uint32_t) override {
+      // Java/SDL owns the physical surface size. Vulkan chooses swapchain extent.
+    }
+    void saveWindowState(HWND, DxvkWindowState*, bool) override { }
+    void restoreWindowState(HWND, DxvkWindowState*, bool) override { }
+    bool setWindowMode(HMONITOR m, HWND w, DxvkWindowState*, const WsiMode& mode) override {
+      WsiMode current;
+      return isWindow(w) && getCurrentDisplayMode(m, &current)
+        && current.width == mode.width && current.height == mode.height
+        && current.bitsPerPixel == mode.bitsPerPixel
+        && (!mode.refreshRate.numerator || (mode.refreshRate.denominator
+          && uint64_t(current.refreshRate.numerator) * mode.refreshRate.denominator
+            == uint64_t(mode.refreshRate.numerator) * current.refreshRate.denominator));
+    }
+    bool enterFullscreenMode(HMONITOR, HWND w, DxvkWindowState*, bool) override {
+      // App owns immersive/fullscreen policy; no exclusive display-mode switch.
+      return isWindow(w);
+    }
+    bool leaveFullscreenMode(HWND w, DxvkWindowState*) override { return isWindow(w); }
+    bool restoreDisplayMode() override { return true; } // never changed the mode
+    HMONITOR getWindowMonitor(HWND w) override { return w ? getDefaultMonitor() : nullptr; }
+    bool isWindow(HWND w) override {
+      uint32_t width, height; getWindowSize(w, &width, &height);
+      return width && height;
+    }
+    bool isMinimized(HWND w) override { return !isWindow(w); }
+    bool isOccluded(HWND w) override { return !isWindow(w); }
+    void updateFullscreenWindow(HMONITOR, HWND, bool) override { }
+    VkResult createSurface(HWND w, PFN_vkGetInstanceProcAddr getProc,
+        VkInstance instance, VkSurfaceKHR* surface) override {
+      if (!surface) return VK_ERROR_INITIALIZATION_FAILED;
+      *surface = VK_NULL_HANDLE;
+      if (!w || !getProc) return VK_ERROR_INITIALIZATION_FAILED;
+      auto create = reinterpret_cast<PFN_vkCreateAndroidSurfaceKHR>(
+        getProc(instance, "vkCreateAndroidSurfaceKHR"));
+      if (!create) return VK_ERROR_EXTENSION_NOT_PRESENT;
+      VkAndroidSurfaceCreateInfoKHR info = {VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR};
+      NativeWindowRef ref(w);
+      if (!ref.window) return VK_ERROR_SURFACE_LOST_KHR;
+      info.window = ref.window;
+      VkResult result = create(instance, &info, nullptr, surface);
+      if (result == VK_SUCCESS && ref.owned) {
+        // Keep the acquired window alive through vkDestroySurfaceKHR, including
+        // the interval after Java destroys/replaces its old Surface.
+        std::lock_guard<std::mutex> lock(surfaceMutex);
+        surfaceWindows[*surface] = ref.window;
+        ref.owned = false;
+      }
+      return result;
+    }
+  };
+  static bool createAndroid(WsiDriver** driver) { *driver = new AndroidWsiDriver(); return true; }
+  WsiBootstrap AndroidWSI = {"Android", createAndroid};
+}
