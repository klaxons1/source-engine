#! /usr/bin/env python
# encoding: utf-8

from waflib import Utils
import os

top = '.'
PROJECT_NAME = 'shaderapidx9'

def options(opt):
	# stub
	return

def configure(conf):
	conf.env.append_unique('DEFINES',[
		'SHADERAPIDX9',
		'SHADER_DLL_EXPORT',
		#'PROTECTED_THINGS_ENABLE', # conflicts with stlport
		'strncpy=use_Q_strncpy_instead',
		'_snprintf=use_Q_snprintf_instead',
	])
	
	if conf.env.DEST_OS == 'win32' and not conf.env.GL:
		conf.env.append_unique('DEFINES',[
			'USE_ACTUAL_DX',
		])


def build(bld):
	source = [
		'colorformatdx8.cpp',
		'../../public/filesystem_helpers.cpp',
		'hardwareconfig.cpp',
		'meshbase.cpp',
		'meshdx8.cpp',
		'shaderapidx8.cpp',
		'shaderdevicebase.cpp',
		'shaderapibase.cpp',
		'shaderdevicedx8.cpp',
		'shadershadowdx8.cpp',
		'texturedx8.cpp',
		'TransitionTable.cpp',
		'cvballoctracker.cpp',
		'vertexdecl.cpp',
		'vertexshaderdx8.cpp',
		#'textureheap.cpp',							[$X360]
		'../../public/tier0/memoverride.cpp'
	]

	if bld.env.DEST_OS == 'win32' and not bld.env.GL:
		source += [
			'recording.cpp',
			'wmi.cpp'
		]
		
	if bld.env.DEST_OS != 'win32':
		source += ['winutils.cpp']

	includes = [
		'.',
		'../../public',
		'../../public/tier0',
		'../../public/tier1',
		'../../common',
		'../'
	] + bld.env.INCLUDES_SDL2

	defines = []

	libs = ['tier0','tier1','tier2','vstdlib','togl','bitmap','mathlib']

	if bld.env.DEST_OS == 'android':
		libs += ['ANDROID_SUPPORT']
	elif bld.env.DEST_OS == 'win32' and not bld.env.GL:
		libs += ['D3D9', 'D3DX9', 'bzip2']
	
	linkflags = []
	if bld.env.SAREK_SDK:
		from scripts.sarek_waf import native_env, native_includes
		bld.read_shlib('dxvk_sarek_d3d9', paths=[bld.env.SAREK_SDK], export_includes=[])
		bld.shlib(source=source + ['sarek_math.cpp'], target='shaderapidx9_sarek',
			name='shaderapidx9_sarek', env=native_env(bld), features='c cxx',
			includes=includes + native_includes(bld), defines=defines,
			use=['tier0','tier1','tier2','vstdlib','bitmap_sarek','mathlib','SDL2','dxvk_sarek_d3d9','ANDROID_SUPPORT'],
			linkflags=['-Wl,-Bsymbolic'], install_path=bld.env.LIBDIR,
			idx=bld.get_taskgen_count())

	if bld.env.DEST_OS == 'android' and bld.env.TOGLES:
		# The companion launcher already loaded its own libtogl.so. Embed ours
		# in the explicitly mod-loaded shaderapi; bind data AND functions locally.
		allowed = ('dx9asmtogl2.cpp', 'dxabstract.cpp', 'glentrypoints.cpp', 'glmgr.cpp',
			'glmgrbasics.cpp', 'cglmtex.cpp', 'cglmfbo.cpp', 'cglmprogram.cpp',
			'cglmbuffer.cpp', 'cglmquery.cpp', 'asanstubs.cpp', 'decompress.c',
			'uh_bcdec.cpp', 'uh_astc.cpp')
		source += ['../../togles/linuxwin/' + p for p in allowed]
		defines += ['UNDERHELL_EMBEDDED_TOGL=1', 'UNDERHELL_ASTC=1', 'TOGL_DLL_EXPORT=1']
		libs.remove('togl')
		libs += ['underhell_astcenc', 'SDL2']
		includes += ['../../togles', '../../togles/thirdparty/astcenc']
		linkflags += ['-Wl,-Bsymbolic']
		# Isolate third-party code from Source's global defines/memory overrides.
		astcenv = bld.env.derive()
		astcenv.DEFINES = ['NDEBUG']
		astcenv.CXXFLAGS = [f for f in astcenv.CXXFLAGS if not f.startswith('-std=')
			and f not in ('-ffast-math', '-funsafe-math-optimizations')] + ['-std=c++14', '-fno-fast-math', '-ffp-contract=off']
		bld.stlib(name='underhell_astcenc', target='underhell_astcenc', env=astcenv,
			source=bld.path.find_node('../../togles/thirdparty/astcenc').ant_glob('astcenc_*.cpp'),
			includes=['../../togles/thirdparty/astcenc'], install_path=None)

	install_path = bld.env.LIBDIR

	bld.shlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		use      = libs,
		linkflags = linkflags,
		install_path = install_path,
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)

